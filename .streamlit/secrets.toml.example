# Copy this file to `.streamlit/secrets.toml` locally, or paste the same keys
# into your deployment platform's secret manager.

# Recommended for deployed WebRTC webcam monitoring:
TWILIO_ACCOUNT_SID = "your_twilio_account_sid"
TWILIO_AUTH_TOKEN = "your_twilio_auth_token"

# Optional alternative if you already have your own TURN/STUN provider.
# Example format:
# RTC_ICE_SERVERS_JSON = '[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]'
